# Copy to .env and edit (install.sh generates it automatically; no manual step needed)
# Required: a random string of at least 32 characters. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# WARNING: it encrypts saved OVH keys and signs login sessions; if lost or changed, saved keys can no longer be decrypted (re-enter them)
SECRET_KEY=change-me-to-a-long-random-string-xxxxxxxxxxxxxxxx

# Default UI language for new visitors / Telegram / CLI: en or zh (each user can switch in the panel)
DEFAULT_LANG=en

# Web port and bind address (used by docker-compose.yml). Use 127.0.0.1 behind Caddy/Nginx/Cloudflare Tunnel
PORT=8000
BIND_ADDR=0.0.0.0

# Set to 1 when served over HTTPS (cookies HTTPS-only)
COOKIE_SECURE=0

# Minimum poll interval allowed per task (seconds)
MIN_POLL_INTERVAL=5

# Display time zone
APP_TZ=Asia/Shanghai
TZ=Asia/Shanghai

# Behind Cloudflare (orange cloud, SSL Flexible/Full): set to 1. CF-Connecting-IP / X-Forwarded-Proto / CF-Visitor are then
# trusted ONLY from Cloudflare's published IP ranges (override with CF_IPS="cidr cidr ..."); requests arriving over https
# get Secure cookies automatically, while direct http://IP:PORT keeps working. See README "Behind Cloudflare".
TRUST_CLOUDFLARE=0
# Optional extra origins for the same-origin POST check (comma separated), normally not needed
# ALLOWED_ORIGINS=https://panel.example.com

# Only trust X-Forwarded-For from these reverse proxies (default 127.0.0.1).
# With Caddy/Nginx outside Docker this is usually the Docker gateway: FORWARDED_ALLOW_IPS=172.16.0.0/12
# FORWARDED_ALLOW_IPS=127.0.0.1


# Optional: referral / affiliate query string appended to the "Order now" links in Telegram restock cards,
# e.g. ORDER_LINK_AFF=utm_source=your-site  (leave empty for plain OVH links)
# ORDER_LINK_AFF=
